<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Generate Trivia Set</title>

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>


<body>

<main class="container">

    <header class="header">

        <div>

            <p class="eyebrow">
                CLAUD'S TRIVIA SYSTEM
            </p>

            <h1>
                GENERATE SET
            </h1>

        </div>


        <nav>
                <a href="/">
                    [dashboard]
                </a>

                <a href="/questions">
                    [questions]
                </a>

                <a href="/generate">
                    [generate]
                </a>

                <a href="/sets">
                    [history]
                </a>

                <a href="/catalog">[catalog]</a>

                <a href="/import">[bulk import]</a>

            </nav>

    </header>


    <section>

        <form
            class="question-form"
            action="/generate"
            method="POST"
        >

            <label>

                NUMBER OF QUESTIONS

                <input
                    type="number"
                    name="count"
                    min="1"
                    max="100"
                    value="30"
                    required
                >

            </label>


            <label>

                MINIMUM AGE (WEEKS)

                <input
                    type="number"
                    name="min_weeks"
                    min="0"
                    value="12"
                    required
                >

            </label>


            <label>

                TOPIC

                <select
                    name="topic"
                >

                    <option value="">
                        all topics
                    </option>


                    <% for (const item of topics) { %>

                        <option
                            value="<%= item.topic %>"
                        >
                            <%= item.topic %>
                        </option>

                    <% } %>

                </select>

            </label>


            <label
                class="checkbox-row"
            >

                <input
                    type="checkbox"
                    name="prefer_unused"
                    checked
                >

                PREFER UNUSED / OLDEST QUESTIONS

            </label>


            <label
                class="checkbox-row"
            >

                <input
                    type="checkbox"
                    name="balance_topics"
                    checked
                >

                BALANCE TOPICS

            </label>


            <button
                type="submit"
            >
                [ GENERATE SET ]
            </button>

        </form>

    </section>

</main>

</body>

</html>