<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalog Editor</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/catalog.css">
</head>
<body>
<main class="container catalog-container">
    <header class="header">
        <div>
            <p class="eyebrow">CLAUD'S TRIVIA SYSTEM</p>
            <h1>CATALOG EDITOR</h1>
        </div>
        <nav>
            <a href="/">[dashboard]</a>
            <a href="/questions">[questions]</a>
            <a href="/generate">[generate]</a>
            <a href="/sets">[sets]</a>
            <a href="/import">[import]</a>
            <a href="/catalog/duplicates">[duplicates]</a>
        </nav>
    </header>

    <% if (updated) { %>
        <p class="catalog-message">updated <%= updated %> question(s)</p>
    <% } %>

    <section>
        <form class="catalog-filter" method="GET" action="/catalog">
            <input type="search" name="search" value="<%= search %>" placeholder="search question, answer, ID...">

            <select name="topic">
                <option value="">all topics</option>
                <% for (const item of topics) { %>
                    <option value="<%= item.topic %>" <%= topic === item.topic ? "selected" : "" %>><%= item.topic %></option>
                <% } %>
            </select>

            <select name="filter">
                <option value="all" <%= filter === "all" ? "selected" : "" %>>all</option>
                <option value="missing_difficulty" <%= filter === "missing_difficulty" ? "selected" : "" %>>no difficulty</option>
                <option value="missing_topic" <%= filter === "missing_topic" ? "selected" : "" %>>no topic</option>
                <option value="missing_format" <%= filter === "missing_format" ? "selected" : "" %>>no format</option>
                <option value="review" <%= filter === "review" ? "selected" : "" %>>needs review</option>
                <option value="disabled" <%= filter === "disabled" ? "selected" : "" %>>disabled</option>
                <option value="enabled" <%= filter === "enabled" ? "selected" : "" %>>enabled</option>
            </select>

            <button type="submit">[filter]</button>
        </form>
    </section>

    <form method="POST" action="/catalog/bulk" id="catalog-bulk-form">
        <section class="catalog-bulk-bar">
            <label><input type="checkbox" id="catalog-select-all"> all</label>

            <select name="bulk_difficulty">
                <option value="">difficulty —</option>
                <option value="1">difficulty 1</option>
                <option value="2">difficulty 2</option>
                <option value="3">difficulty 3</option>
                <option value="4">difficulty 4</option>
                <option value="5">difficulty 5</option>
            </select>

            <select name="bulk_topic">
                <option value="">topic —</option>
                <% for (const item of topics) { %>
                    <option value="<%= item.topic %>"><%= item.topic %></option>
                <% } %>
            </select>

            <select name="bulk_format">
                <option value="">format —</option>
                <% for (const item of formats) { %>
                    <option value="<%= item.format %>"><%= item.format %></option>
                <% } %>
            </select>

            <select name="bulk_enabled">
                <option value="">status —</option>
                <option value="1">enable</option>
                <option value="0">disable</option>
            </select>

            <label><input type="checkbox" name="mark_reviewed"> reviewed</label>
            <button type="submit">[apply selected]</button>
        </section>

        <section>
            <h2>RESULTS / <%= questions.length %></h2>

            <div class="catalog-list">
                <% for (const item of questions) { %>
                    <article class="catalog-row">
                        <div class="catalog-select">
                            <input class="catalog-row-checkbox" type="checkbox" name="ids" value="<%= item.id %>">
                        </div>

                        <div class="catalog-main">
                            <div class="catalog-head">
                                <a class="question-code" href="/questions/<%= item.id %>"><%= item.question_code %></a>
                                <span>used <%= item.times_used %></span>
                                <span><%= item.last_used || "never" %></span>
                                <% if (item.needs_review) { %><span class="warning">review</span><% } %>
                                <% if (!item.enabled) { %><span class="warning">disabled</span><% } %>
                            </div>

                            <p class="catalog-question"><%= item.question %></p>
                            <p class="catalog-answer">→ <%= item.answer %></p>

                            <div class="catalog-fields">
                                <span>topic: <%= item.topic || "-" %></span>
                                <span>diff: <%= item.difficulty ?? "-" %></span>
                                <span>format: <%= item.format || "-" %></span>
                            </div>
                        </div>
                    </article>
                <% } %>
            </div>
        </section>
    </form>
</main>
<script src="/js/catalog.js"></script>
</body>
</html>
